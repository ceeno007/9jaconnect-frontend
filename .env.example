# Server-only backend origin (not exposed to the browser).
# Browser calls /api/v1/* on this app; Next.js proxies to this host.
API_BASE_URL=https://api.9jaconnet.com

# Required for Sign in / Sign up with Google (customers + professionals).
# Create an OAuth 2.0 Web client ID in Google Cloud Console and add your
# site origin (e.g. http://localhost:3000 and https://yourdomain.com).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Obscure ops sign-in path segment (no leading slash). Keep this private.
# Sign-in URL becomes /{value}/login
NEXT_PUBLIC_ADMIN_AUTH_BASE=nc-x8f3k2m9

# Optional AdSense publisher client id (ca-pub-...). Ads render only when set.
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=
